{
  "expo": {
    "name": "Axo",
    "slug": "axo-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1F2126",
    "android": {
      "package": "ai.axomlabs.axo",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#24282F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Axo uses the camera to scan the pairing QR code.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#1F2126"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Axo attaches photos you choose to messages.",
          "cameraPermission": "Axo uses the camera to take photos to send to your agents.",
          "microphonePermission": "Axo records audio when you film a video to send to an agent."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/GoogleSans-Regular.ttf",
            "./assets/fonts/GoogleSans-Medium.ttf",
            "./assets/fonts/GoogleSans-Bold.ttf"
          ]
        }
      ]
    ]
  }
}
